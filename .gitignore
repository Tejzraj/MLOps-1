# ==============================================================================
# Byte-compiled / optimized / DLL files
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==============================================================================
# Virtual Environments
# ==============================================================================
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==============================================================================
# Operating System Files
# ==============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================================================================
# IDEs and Editors
# ==============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# ==============================================================================
# Environment Variables & Secrets
# ==============================================================================
.env
.env.*
!.env.example
*.env
secrets.yaml
credentials.json

# ==============================================================================
# Jupyter Notebooks Checkpoints
# ==============================================================================
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# ==============================================================================
# Testing, Coverage & Quality Tools
# ==============================================================================
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ==============================================================================
# Data and Artifacts (tracked via DVC, ignored by Git)
# ==============================================================================
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

data/interim/*
!data/interim/.gitkeep
!data/interim/README.md

data/processed/*
!data/processed/.gitkeep
!data/processed/README.md

# Model Artifacts (tracked via DVC / MLflow Model Registry)
models/*
!models/.gitkeep
!models/README.md

# Reports figures generated at runtime
reports/figures/*
!reports/figures/.gitkeep

# ==============================================================================
# MLflow local execution tracking
# ==============================================================================
mlruns/*
!mlruns/.gitkeep
.mlflow/

# ==============================================================================
# DVC (Data Version Control)
# ==============================================================================
# DVC caches and internal tracking
/data/**/.dvc
.dvc/cache
.dvc/tmp

# DO NOT ignore .dvc files, dvc.yaml, dvc.lock, params.yaml
*.egg-info/
notebooks/mlruns/

# Isolated Phase 2 artifact validation
.venv-validation/

# Phase 2 experiments: environments and all generated outputs
.venv-experiments/
artifacts/phase2/
wandb/

# Separate local FastAPI runtime
.venv-api/

# Separate GX data-validation environment
.venv-gx/

# Standalone private Registry download environment
.venv-retrieval/

# Original generated validation evidence: keep local, includes paths/learned vocabulary
/docs/phase2/local_model_validation.json
/docs/phase2/local_model_validation.md
/docs/phase2/skops_type_inspection.json
# Defense in depth for private model handoffs and SDK caches
*.joblib
*.skops
*.zip
wandb-cache/
wandb-data/
wandb-config/

# Combined frontend/API integration environment
frontend/.venv-integration/
frontend/.venv-ui311/
