# Deny by default: no Git metadata, datasets, artifacts or secrets enter the context.
**
!frontend/
!frontend/Dockerfile
!frontend/requirements.txt
!frontend/__init__.py
!frontend/app.py
!frontend/api_client.py
!frontend/config.py
!frontend/question_bank.py
!frontend/params.yaml
!frontend/questions.yaml

# Explicit exclusions document sensitive/heavy paths (also covered by **).
**/.git
**/.venv
**/venv
**/__pycache__
**/.pytest_cache
**/.env
**/.env.*
**/.aws
**/.ssh
**/.streamlit/secrets.toml
**/*secret*
**/*credential*
**/*.pem
**/*.key
data
models
artifacts
reports
mlruns
mlartifacts
wandb
.dvc
.dvc/cache
**/*.dvc
**/*.parquet
**/*.pkl
**/*.joblib
**/*.onnx
